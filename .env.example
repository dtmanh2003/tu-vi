# Chọn AI cho chatbot: ollama (chạy local, miễn phí, mặc định) hoặc claude (Claude API, cần key)
LLM_PROVIDER=ollama

# --- Ollama (local) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# Model cho chế độ "Kỹ" (chậm hơn, chính xác hơn)
OLLAMA_MODEL_DEEP=qwen3:8b
# Chế độ "suy nghĩ trước khi trả lời" cho Qwen3/DeepSeek-R1 (chậm hơn). Mặc định tắt.
OLLAMA_THINK=false

# --- Claude API (chỉ cần khi LLM_PROVIDER=claude) ---
# Lấy key tại https://console.anthropic.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

API_PORT=3001
